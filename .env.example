# ── PULSE: пример конфигурации ──
# Скопируйте в .env.local и заполните. Файлы .env* (кроме этого) не коммитятся.

# PostgreSQL 15+ для запуска через npm. Docker Compose задаёт адрес базы сам.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulse?schema=public"

# Секрет подписи сессий: минимум 32 символа. Сгенерировать: openssl rand -base64 48
SESSION_SECRET=""

# Ключ Anthropic API. Хранится только на сервере, в браузер не передаётся.
# Пустое значение — PULSE работает на локальных алгоритмах (классификация по словарю, TF-IDF).
ANTHROPIC_API_KEY=""

# AI: модели и ограничения расходов
AI_ENABLED="true"                      # false — полностью отключить внешнюю модель
AI_MODEL_FAST="claude-haiku-5-5"       # подача обращения, разбор для ответственного
AI_MODEL_SMART="claude-sonnet-5-5"     # аналитическая сводка для руководства
AI_DAILY_BUDGET_USD="1.00"             # дневной лимит; после него — локальные алгоритмы
AI_USER_LIMIT_PER_10MIN="20"           # запросов к модели на пользователя за 10 минут
AI_TIMEOUT_MS="20000"                  # таймаут запроса (сводка — до 90 с)

# Демо-режим: быстрый вход под демо-аккаунтами на странице логина. В продакшене — false.
DEMO_MODE="true"

# Битрикс24 (необязательно): уведомления в групповой чат через входящий вебхук с правом «im».
# REST API доступен на платных тарифах Битрикс24, включая пробный период.
# BITRIX24_WEBHOOK_URL="https://<портал>.bitrix24.ru/rest/<id>/<код>/"
# BITRIX24_DIALOG_ID="chat123"
# Публичный адрес PULSE для ссылок в сообщениях
# PULSE_PUBLIC_URL="https://pulse.example.ru"
# BITRIX24_ENABLED="false"   # выключить, не удаляя настройки

# Необязательно: секрет для внешнего планировщика эскалаций (POST /api/cron/sla), минимум 16 символов
# CRON_SECRET=""

# Только за доверенным обратным прокси: учитывать X-Forwarded-For для лимита попыток входа
# TRUST_PROXY="false"
